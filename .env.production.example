# Copy to .env on the VPS:  cp .env.production.example .env
# Never commit the real .env. Avoid "$" in any value (Docker Compose treats it as a variable).

APP_NAME=WMS
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_LEVEL=warning

# MySQL (the mysql container is created with these values on first start)
DB_DATABASE=wms
DB_USERNAME=wms
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Password for the users created by the seeder (superadmin, admin, cashier). Change it after first login.
SEED_USER_PASSWORD=

# Frontend origin(s) allowed by CORS, comma separated
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Brevo transactional email
MAIL_MAILER=log
BREVO_API_KEY=
BREVO_FROM_ADDRESS=
BREVO_FROM_NAME=WMS
